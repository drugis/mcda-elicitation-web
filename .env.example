# Minimal example local environment for mcda-elicitation-web
# Copy this file to .env and fill in the placeholders before running locally.

# Required: PostgreSQL credentials used by the application
POSTGRES_USER=mcda_user
POSTGRES_PASSWORD=your_local_db_password_here
POSTGRES_DB=mcda

# Required: Authentication mode (e.g. LOCAL or GOOGLE)
AUTH_MODE=LOCAL

# Required when running locally: Google OAuth dummy values (used in LOCAL for testing)
MCDAWEB_GOOGLE_KEY=dummy-google-key
MCDAWEB_GOOGLE_SECRET=dummy-google-secret
MCDAWEB_COOKIE_SECRET=local-dev-cookie-secret

# Required: API key forwarded from Node to Plumber (dev value)
PATAVI_API_KEY=devkey
