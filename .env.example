# Example local environment file for mcda-elicitation-web
# Copy to .env and fill in values before running locally

# API key forwarded from Node to Plumber (DO NOT commit real values)
PATAVI_API_KEY=your_dev_patavi_api_key_here

# URL where the Plumber API is reachable from Node (for local docker-compose)
PLUMBER_API_URL=http://plumber-api:8000

# Database connection for local dev (example)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=mcda
POSTGRES_PASSWORD=mcda
POSTGRES_DB=mcda

# Node backend settings
NODE_ENV=development

# Optional: override ports
PLUMBER_PORT=8000
NODE_BACKEND_PORT=3000
